<IfModule mod_rewrite.c>
  RewriteEngine On

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route clean API paths to PHP backend controllers
  RewriteRule ^properties/check-rera/?$ api/properties/check_rera.php [QSA,L]
  RewriteRule ^properties/detail/([^/]+)/?$ api/properties/detail.php?id=$1 [QSA,L]
  RewriteRule ^properties/detail-by-id/([^/]+)/?$ api/properties/detail.php?id=$1 [QSA,L]
  RewriteRule ^properties/public/detail/([^/]+)/?$ api/properties/detail.php?slug=$1 [QSA,L]
  RewriteRule ^properties/public/?$ api/properties/index.php?public=1 [QSA,L]
  RewriteRule ^properties/([^/]+)/submit/?$ api/properties/submit.php?id=$1 [QSA,L]
  RewriteRule ^properties/([^/]+)/approve/?$ api/properties/approve.php?id=$1 [QSA,L]
  RewriteRule ^properties/([^/]+)/share/?$ api/properties/share.php?id=$1 [QSA,L]
  RewriteRule ^properties/([0-9]+)/?$ api/properties/index.php?id=$1 [QSA,L]
  RewriteRule ^properties/?$ api/properties/index.php [QSA,L]

  RewriteRule ^announcements/admin/?$ api/announcements/admin.php?action=admin [QSA,L]
  RewriteRule ^announcements/create\.php$ api/announcements/create.php [QSA,L]
  RewriteRule ^announcements/update\.php$ api/announcements/update.php [QSA,L]
  RewriteRule ^announcements/delete\.php$ api/announcements/delete.php [QSA,L]
  RewriteRule ^announcements/([0-9]+)/?$ api/announcements/index.php?id=$1 [QSA,L]
  RewriteRule ^announcements/?$ api/announcements/index.php [QSA,L]

  RewriteRule ^branches/([0-9]+)/?$ api/branches/index.php?id=$1 [QSA,L]
  RewriteRule ^branches/?$ api/branches/index.php [QSA,L]

  RewriteRule ^users/brokers/?$ api/users/brokers.php [QSA,L]
  RewriteRule ^users/broker-staff/?$ api/users/broker_staff.php [QSA,L]
  RewriteRule ^users/broker_staff\.php$ api/users/broker_staff.php [QSA,L]
  RewriteRule ^users/broker/([0-9]+)/logs/?$ api/users/broker_logs.php?broker_id=$1 [QSA,L]
  RewriteRule ^users/([0-9]+)/?$ api/users/index.php?id=$1 [QSA,L]
  RewriteRule ^users/?$ api/users/index.php [QSA,L]

  RewriteRule ^leads/public/?$ api/leads/create.php?public=1 [QSA,L]
  RewriteRule ^leads/([0-9]+)/status/?$ api/leads/index.php?id=$1 [QSA,L]
  RewriteRule ^leads/([0-9]+)/?$ api/leads/index.php?id=$1 [QSA,L]
  RewriteRule ^leads/?$ api/leads/index.php [QSA,L]

  RewriteRule ^auth/login/?$ api/auth/login.php [QSA,L]
  RewriteRule ^auth/profile/?$ api/auth/profile.php [QSA,L]

  # Catch-all rule for any unhandled routes to api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ api/$1 [QSA,L]
</IfModule>